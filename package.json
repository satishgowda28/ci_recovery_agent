{
  "name": "ai-ci-recovery-agent",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "main": "eslint.config.js",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "private": "true",
  "scripts": {
    "dev:agent": "npm run dev --workspace=@agent/core",
    "test:agent": "vitest run apps/agent",
    "test:shared": "vitest run packages/shared",
    "dev:frontend": "npm run dev --workspace=@demo/frontend",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck:agent": "npm run typecheck --workspace=@agent/core",
    "_lint": "npm run lint --workspaces --if-present",
    "_typecheck": "npm run typecheck --workspaces --if-present",
    "_test": "npm run test --workspaces --if-present",
    "_build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}